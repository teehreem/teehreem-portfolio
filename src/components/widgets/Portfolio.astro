
---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

const { id, title, subtitle, tagline } = Astro.props;
---

<WidgetWrapper id={id} containerClass="max-w-6xl">
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
  />

  <div class="space-y-16 md:space-y-20 mt-12 md:mt-16">

    <!-- Chaaye Khana -->
    <section>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-bold">
          Chaaye Khana
        </h2>

        <a
          href="/portfolio"
          class="text-primary font-semibold hover:underline"
        >
          View Full Portfolio →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8">

        <img
          src="/images/chaaye-khana/1.jpg"
          alt="Chaaye Khana social media work"
          class="w-full h-auto rounded-3xl shadow-lg transition-all duration-300 md:hover:-translate-y-2 md:hover:shadow-2xl"
          loading="lazy"
          decoding="async"
        />

        <img
          src="/images/chaaye-khana/2.jpg"
          alt="Chaaye Khana content campaign"
          class="w-full h-auto rounded-3xl shadow-lg transition-all duration-300 md:hover:-translate-y-2 md:hover:shadow-2xl"
          loading="lazy"
          decoding="async"
        />

      </div>
    </section>

    <!-- Leafy Brew -->
    <section>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-bold">
          Leafy Brew
        </h2>

        <a
          href="/portfolio"
          class="text-primary font-semibold hover:underline"
        >
          View Full Portfolio →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">

        <img
          src="/images/leafy-brew/1.jpg"
          alt="Leafy Brew branding work"
          class="w-full h-auto rounded-3xl shadow-lg transition-all duration-300 md:hover:-translate-y-2 md:hover:shadow-2xl"
          loading="lazy"
          decoding="async"
        />

        <img
          src="/images/leafy-brew/2.jpg"
          alt="Leafy Brew social media content"
          class="w-full h-auto rounded-3xl shadow-lg transition-all duration-300 md:hover:-translate-y-2 md:hover:shadow-2xl"
          loading="lazy"
          decoding="async"
        />

      </div>
    </section>

    <div class="text-center">
      <a
        href="/portfolio"
        class="inline-flex items-center justify-center rounded-full bg-primary px-7 py-3.5 md:px-8 md:py-4 text-white font-semibold hover:bg-secondary transition"
      >
        View Complete Portfolio →
      </a>
    </div>

  </div>
</WidgetWrapper>
