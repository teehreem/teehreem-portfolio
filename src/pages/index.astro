---
import Layout from '~/layouts/PageLayout.astro';
import Agencies from '~/components/widgets/Agencies.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Portfolio from '~/components/widgets/Portfolio.astro';
import Brands from '~/components/widgets/Brands.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Contact from '~/components/widgets/Contact.astro';

const metadata = {
  title: "Tehreem | Digital Marketing, Content & UGC Portfolio",
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'View My Work',
        href: '#portfolio',
        icon: 'tabler:briefcase',
      },
      { text: 'My Services', href: '#services' },
    ]}
image={{ src: '~/assets/images/hero-image-2.png', alt: "Tehreem Portfolio Hero Image" }}  >
    <Fragment slot="title">
  Hi, I'm <span class="text-accent dark:text-white">Tehreem</span>.<br />
  I create content that people actually stop scrolling for.
</Fragment>

    <Fragment slot="subtitle">

  Social media manager, content creator and designer helping brands grow through strategy, visuals and content that converts.

</Fragment>
  </Hero>



  <!-- Features Widget *************** -->

  <Features
    id="services"
  classes={{
    container: "bg-slate-50 rounded-3xl p-12"
  }}
  tagline="Services"
    title="Helping brands grow through strategy, content & design."
    subtitle="From social media management and content strategy to branding, websites and digital experiences, I help businesses build an online presence that people remember."
    items={[
      {
        title: 'Social Media Management',
        description:
          'End-to-end social media management including content planning, publishing, community management and growth strategies.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'Content Strategy',
        description:
          'Content calendars, trend research and platform-specific strategies designed to help brands grow organically.',
        icon: 'tabler:components',
      },
      {
        title: 'Video Editing',
        description:
          'High-performing Reels, TikToks and short-form videos edited using Premiere Pro, After Effects and CapCut.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Web Design & Development',
        description:
          'Business websites, landing pages, ecommerce setup, Stan Store optimisation and custom web experiences through AINIX.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Brand Design',
        description:
          "Logo systems, brand identity, Canva designs, marketing assets and visuals that create a memorable brand presence.",
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Marketing Campaigns',
        description:
          'Creative campaigns, launch strategies and digital marketing plans designed to increase visibility, engagement and sales.',
        icon: 'tabler:bulb',
      },
    ]}
  />
<!-- Features2 Widget ************** -->

  <Features2
    id="clients"
    title="Brands I've Worked With"
    subtitle="Helping businesses grow through social media management, content strategy, branding, content creation, paid campaigns and digital marketing."
    tagline="SELECTED CLIENTS"
    items={[
    {
  title: 'Chaaye Khana',
  description:
    'Social media management, content strategy, content creation, ad campaigns and influencer marketing.',
  icon: 'tabler:coffee',
},
{
  title: 'Leafy Brew',
  description:
    'Complete social media management, branding, creative content, growth strategy and campaign management.',
  icon: 'tabler:leaf',
},
{
  title: 'Jungle Barracks & Resorts',
  description:
    'Content creation, social media management, creative direction and hospitality marketing.',
  icon: 'tabler:trees',
},
{
  title: 'Padel Power Hub',
  description:
    'Brand growth, social media management, launch campaigns and engaging sports content.',
  icon: 'tabler:ball-tennis',
},
{
  title: 'FastMeds Australia',
  description:
    'Healthcare marketing, content strategy, digital campaigns and social media management.',
  icon: 'tabler:medical-cross',
},
{
  title: 'AINIX',
  description:
    'Website design & development, landing pages, ecommerce websites, Stan Store setup & optimization, SEO and digital marketing.',
  icon: 'tabler:code',
},
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

 <Portfolio
  id="portfolio"
  tagline="SELECTED WORK"
  title="Selected Work"
  subtitle="A selection of client work across social media, branding, content creation and digital marketing."
/>
  
<Agencies />

<Contact id="contact" />

  
  

  <!-- HighlightedPosts Widget ******* -->

  

