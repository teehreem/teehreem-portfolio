---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Portfolio',
};

const projects = [
  {
    category: "Social Media Management",
    title: "Chaaye Khana",
    description:
      "From campaign concepts and social media management to content creation, influencer marketing and paid advertising, we helped bring Chaaye Khana's stories to life across every platform.",
    imageFolder: "chaaye-khana",
    videoFolder: "",
    images: 7,
    videos: 0,
  },
  {
    category: "Branding & Social Media",
    title: "Leafy Brew",
    description:
      "Built from the ground up, Leafy Brew's identity combines thoughtful branding, creative direction and social-first content designed to give a new café a memorable digital presence.",
    imageFolder: "leafy-brew",
    videoFolder: "",
    images: 8,
    videos: 0,
  },
  {
    category: "Hospitality Marketing",
    title: "Jungle Barracks & Resorts",
    description:
      "Created to capture the experience beyond the destination, this collection focuses on visual storytelling that reflects the atmosphere, hospitality and character of the resort.",
    imageFolder: "jungle-barracks",
    videoFolder: "",
    images: 8,
    videos: 0,
  },
  {
    category: "Sports Marketing",
    title: "Padel Power Hub",
    description:
      "From launch campaigns to day-to-day content, we created a bold social presence that introduced the brand, built community and kept players engaged both on and off the court.",
    imageFolder: "padel-power-hub",
    videoFolder: "",
    images: 11,
    videos: 0,
  },
  {
    category: "Healthcare Marketing",
    title: "FastMeds Australia",
    description:
      "Designed for clarity and trust, this content simplifies healthcare communication through clean visuals, educational campaigns and informative social media content.",
    imageFolder: "fastmeds-australia",
    videoFolder: "",
    images: 12,
    videos: 0,
  },
  {
    category: "Our Agency",
    title: "AINIX",
    description:
      "AINIX is our web design and development agency, where we build modern websites, landing pages and digital experiences that combine thoughtful strategy with clean, user-focused design.",
    imageFolder: "ainix",
    videoFolder: "",
    images: 3,
    videos: 0,
  },
  {
    category: "Our Agency",
    title: "Swatch",
    description:
      "Swatch is our creative marketing and PR agency, bringing together branding, strategy, content creation and social media management to help businesses build meaningful, lasting brands.",
    imageFolder: "swatch",
    videoFolder: "",
    images: 3,
    videos: 0,
  },
  {
    category: "Print Design",
    title: "Print Design",
    description:
      "A curated collection of print work spanning wedding invitations, menus, stationery and marketing collateral, designed with the same attention to detail that shapes every digital project.",
    imageFolder: "print-design",
    videoFolder: "",
    images: 9,
    videos: 0,
  },
];
---

<Layout metadata={metadata}>

<section class="max-w-7xl mx-auto px-6 py-24">

  <div class="text-center mb-24">

    <p class="uppercase tracking-[0.2em] text-primary font-semibold">
      Social Graphics
    </p>

    <h1 class="text-5xl md:text-6xl font-bold mt-4">
      Portfolio
    </h1>

    <p class="text-xl text-muted max-w-3xl mx-auto mt-6">
      A collection of social media management, branding,
      content creation, web design and digital marketing projects.
    </p>

  </div>

  {
    projects.map((project) => (

      <section class="mb-28">

        <div class="mb-10">

          <p class="uppercase tracking-[0.2em] text-primary text-sm font-semibold">

            {project.category}

          </p>

          <h2 class="text-4xl font-bold mt-3">

            {project.title}

          </h2>

          <p class="text-muted max-w-3xl mt-5">

            {project.description}

          </p>

        </div>

        {/* IMAGE GRID */}

        <div class="grid grid-cols-2 lg:grid-cols-3 gap-6">

          {
            Array.from({ length: project.images }).map((_, index) => (

              <img
                src={`/images/${project.imageFolder}/${index + 1}.jpg`}
                alt={`${project.title} ${index + 1}`}
                class="rounded-3xl shadow-lg hover:-translate-y-2 hover:shadow-2xl transition-all duration-300"
                loading="lazy"
              />

            ))
          }

        </div>
        

      </section>

    ))
  }

</section>

</Layout>